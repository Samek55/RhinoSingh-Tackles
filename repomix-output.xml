  cardHeader: {
    flexDirection: 'row',
    alignItems: 'stretch',
    width: '100%',
  },
  leftSection: {
    flex: 2,
    justifyContent: 'space-between',
  },
  rightSection: {
    alignItems: 'flex-end',
