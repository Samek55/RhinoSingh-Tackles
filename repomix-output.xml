    marginTop: hp('0.3%'),
    fontSize: hp('1.5%'),
    color: '#555',
  },
  budget: {
    fontSize: hp('1.6%'),
    color: '#555',
    marginTop: hp('0.5%'),
  },
  infoContainer: {
    marginTop: 3,
  },
  status: {
    fontWeight: '700',
    fontSize: hp('1.6%'),
  },
  completed: { color: 'green' },
