# Copy to .env and fill in values. Required for local dev AND EAS production builds.
# After updating .env, sync to EAS: npm run sync-eas-env
#
# EAS only embeds EXPO_PUBLIC_* vars at build time. Your local .env is gitignored
# and is NOT uploaded automatically — run sync-eas-env before production builds.

# Airtable
EXPO_PUBLIC_AIRTABLE_API_URL_BOOKING=https://api.airtable.com/v0/YOUR_BASE_ID/Booking
EXPO_PUBLIC_AIRTABLE_API_URL_SERVICES=https://api.airtable.com/v0/YOUR_BASE_ID/Services
EXPO_PUBLIC_AIRTABLE_API_URL_CAREER=https://api.airtable.com/v0/YOUR_BASE_ID/workForce
EXPO_PUBLIC_AIRTABLE_API_URL_PARTNERSHIP=https://api.airtable.com/v0/YOUR_BASE_ID/Partnership
EXPO_PUBLIC_AIRTABLE_API_URL_HELPBOX=https://api.airtable.com/v0/YOUR_BASE_ID/HelpBox
EXPO_PUBLIC_AIRTABLE_API_URL_ADMIN=https://api.airtable.com/v0/YOUR_BASE_ID/Admin
EXPO_PUBLIC_AIRTABLE_TOKEN=patYOUR_AIRTABLE_TOKEN
EXPO_PUBLIC_AIRTABLE_BASE_ID=appYOUR_BASE_ID

# Cloudinary
EXPO_PUBLIC_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/YOUR_CLOUD/image/upload
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Twilio
EXPO_PUBLIC_TWILIO_BASE_URL=https://your-account.twil.io
EXPO_PUBLIC_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OneSignal (client SDK — required in EAS for push to work)
EXPO_PUBLIC_ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EXPO_PUBLIC_ONESIGNAL_REST_API_KEY=os_v2_app_xxxxxxxx

# Server-only OneSignal keys (Vercel/backend — not needed in mobile EAS env)
ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ONESIGNAL_REST_API_KEY=os_v2_app_xxxxxxxx

EXPO_PUBLIC_NOTIFY_PROFESSIONALS_URL=https://your-region-your-project.cloudfunctions.net/notifyProfessionals

# Backend API (use production URL for EAS production; 10.0.2.2 is emulator-only)
EXPO_PUBLIC_API_URL2=https://your-backend.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# Firebase (web SDK config — all fields required for auth/database in production)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyxxxxxxxx
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:xxxxxxxx
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
EXPO_PUBLIC_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app

# SMS / OTP
EXPO_PUBLIC_INFOBIP_API_KEY=your-infobip-api-key
EXPO_PUBLIC_INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
EXPO_PUBLIC_2FACTOR_API_KEY=your-2factor-api-key

# Supabase (required — app crashes without these in production)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# EAS build only (file secret — set manually in EAS dashboard, not in .env)
# GOOGLE_SERVICES_JSON=<contents of google-services.json>
